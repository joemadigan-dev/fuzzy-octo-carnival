{
  "name": "jm-financial-conditions-barometer",
  "version": "1.0.0",
  "description": "The Joe Madigan Financial Conditions Barometer — a live macro KPI dashboard on Cloudflare Workers + D1.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply the-wall --local",
    "migrate:remote": "wrangler d1 migrations apply the-wall --remote",
    "backfill:local": "node --experimental-strip-types scripts/local-backfill.mts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.5.4",
    "uplot": "^1.6.32",
    "wrangler": "^4.119.0"
  }
}
